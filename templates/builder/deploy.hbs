<section class="tab {{#if (eq activeTab "deploy")}}active{{/if}}" data-tab="deploy" data-group="primary">
  <div class="peb-columns">
    <div class="peb-panel">
      <h3>{{localize "sargas-encounter-builder.deploy.options"}}</h3>
      <div class="peb-filters">
        <label class="span2">{{localize "sargas-encounter-builder.deploy.scene"}}
          <select name="deploy.sceneId">{{#each deploy.scenes}}<option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>{{/each}}</select>
        </label>
        <label>{{localize "sargas-encounter-builder.deploy.importPolicy"}}
          <select name="deploy.importPolicy">
            <option value="reuse" {{#if (eq deploy.options.importPolicy "reuse")}}selected{{/if}}>{{localize "sargas-encounter-builder.deploy.policy.reuse"}}</option>
            <option value="fresh" {{#if (eq deploy.options.importPolicy "fresh")}}selected{{/if}}>{{localize "sargas-encounter-builder.deploy.policy.fresh"}}</option>
          </select>
        </label>
        <label>{{localize "sargas-encounter-builder.deploy.combat"}}
          <select name="deploy.addToCombat">
            <option value="none" {{#if (eq deploy.options.addToCombat "none")}}selected{{/if}}>{{localize "sargas-encounter-builder.deploy.combatNone"}}</option>
            <option value="active" {{#if (eq deploy.options.addToCombat "active")}}selected{{/if}}>{{localize "sargas-encounter-builder.deploy.combatActive"}}</option>
            <option value="new" {{#if (eq deploy.options.addToCombat "new")}}selected{{/if}}>{{localize "sargas-encounter-builder.deploy.combatNew"}}</option>
          </select>
        </label>
        <label><input type="checkbox" name="deploy.hidden" {{#if deploy.options.hidden}}checked{{/if}}> {{localize "sargas-encounter-builder.deploy.hidden"}}</label>
        <label><input type="checkbox" name="deploy.numberDuplicates" {{#if deploy.options.numberDuplicates}}checked{{/if}}> {{localize "sargas-encounter-builder.deploy.numberDuplicates"}}</label>
      </div>
      <div class="peb-toolbar">
        <span>{{localize "sargas-encounter-builder.deploy.origin"}}: <strong>{{deploy.origin}}</strong></span>
        <button type="button" data-action="ext" data-ext="deploy" data-method="pickOrigin" {{#if deploy.pickingOrigin}}disabled{{/if}}><i class="fa-solid fa-crosshairs"></i> {{#if deploy.pickingOrigin}}{{localize "sargas-encounter-builder.deploy.clickCanvas"}}{{else}}{{localize "sargas-encounter-builder.deploy.pickOrigin"}}{{/if}}</button>
        <button type="button" data-action="ext" data-ext="deploy" data-method="clearOrigin"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="peb-messages">
        {{#each deploy.preview.blockers}}<div class="peb-msg error">{{this}}</div>{{/each}}
        {{#each deploy.preview.warnings}}<div class="peb-msg warn">{{this}}</div>{{/each}}
      </div>
      <div class="peb-toolbar">
        <button type="button" data-action="ext" data-ext="deploy" data-method="deploy" {{#unless deploy.canDeploy}}disabled{{/unless}}><i class="fa-solid fa-chess-knight"></i> {{localize "sargas-encounter-builder.deploy.deployButton"}}</button>
        {{#if deploy.busy}}<span class="peb-tags">{{localize "sargas-encounter-builder.deploy.working"}}</span>{{/if}}
      </div>
      <div class="peb-tags">{{localize "sargas-encounter-builder.deploy.neverHint"}}</div>
    </div>
    <div class="peb-panel">
      <h3>{{localize "sargas-encounter-builder.deploy.preview"}} ({{deploy.preview.totalTokens}} {{localize "sargas-encounter-builder.deploy.tokens"}})</h3>
      {{#if deploy.preview.scene}}<div class="peb-tags">{{deploy.preview.scene.name}} · {{deploy.preview.scene.gridLabel}}</div>{{/if}}
      <div class="peb-scroll">
        <table class="peb-table">
          <thead><tr><th>{{localize "sargas-encounter-builder.build.name"}}</th><th class="num">{{localize "sargas-encounter-builder.build.qty"}}</th><th>{{localize "sargas-encounter-builder.deploy.policyHeader"}}</th></tr></thead>
          <tbody>
          {{#each deploy.preview.actors}}
          <tr><td>{{this.name}}<div class="peb-tags">{{this.sourceUuid}}</div></td><td class="num">{{this.quantity}}</td><td>{{this.policyLabel}}</td></tr>
          {{else}}
          <tr><td colspan="3">{{localize "sargas-encounter-builder.build.emptyDraft"}}</td></tr>
          {{/each}}
          </tbody>
        </table>
      </div>
      {{#if deploy.outcome}}
      <h3>{{localize "sargas-encounter-builder.deploy.result"}}</h3>
      <div class="peb-messages">
        <div class="peb-msg {{#if deploy.outcome.partial}}warn{{else}}ok{{/if}}">
          {{localize "sargas-encounter-builder.deploy.summary" actors=deploy.outcome.summary.created.Actor tokens=deploy.outcome.summary.created.Token combats=deploy.outcome.summary.created.Combat combatants=deploy.outcome.summary.created.Combatant reused=deploy.outcome.summary.reused}}
          {{#if deploy.outcome.unplaced}} · {{localize "sargas-encounter-builder.deploy.unplaced" count=deploy.outcome.unplaced}}{{/if}}
        </div>
        {{#each deploy.outcome.failures}}<div class="peb-msg error">{{this}}</div>{{/each}}
        {{#if deploy.outcome.cleanupDone}}<div class="peb-msg">{{localize "sargas-encounter-builder.deploy.cleanupDone" removed=deploy.outcome.cleanupDone.removed failed=deploy.outcome.cleanupDone.failed}}</div>{{/if}}
      </div>
      <details><summary>{{localize "sargas-encounter-builder.deploy.ledger"}}</summary>
        <div class="peb-tags">{{#each deploy.outcome.created}}<div>+ {{this}}</div>{{/each}}{{#each deploy.outcome.reused}}<div>= {{this}}</div>{{/each}}</div>
      </details>
      {{#if deploy.outcome.canCleanup}}
      <div class="peb-toolbar">
        <button type="button" data-action="ext" data-ext="deploy" data-method="cleanup"><i class="fa-solid fa-broom"></i> {{localize "sargas-encounter-builder.deploy.cleanup"}}</button>
        <span class="peb-tags">{{localize "sargas-encounter-builder.deploy.cleanupHint"}}</span>
      </div>
      {{/if}}
      {{/if}}
    </div>
  </div>
</section>
