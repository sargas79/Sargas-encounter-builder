<div class="seb-snapshot">
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.header.party"}}</span>{{snap.partyName}} ({{snap.partySize}})</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.header.levels"}}</span>{{snap.levels}}</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.header.referenceShort"}}</span>{{snap.referenceLevel}}</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.evaluation.selected"}}</span>{{snap.threatLabel}}</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.evaluation.target"}}</span>{{#if (ne snap.target null)}}{{snap.target}} XP{{else}}—{{/if}}</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.evaluation.supported"}}</span>{{snap.supportedXP}} XP {{snap.differenceLabel}}</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.evaluation.inferred"}}</span>{{snap.inferredLabel}} ({{snap.completeLabel}})</span>
  <span><span class="seb-eyebrow">{{localize "sargas-encounter-builder.saved.when"}}</span>{{snap.when}}</span>
</div>
