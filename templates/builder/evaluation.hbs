{{!-- Shared evaluation summary partial: expects `ev` (evaluation context) --}}
<div class="peb-evaluation">
  <div class="peb-stat"><label>{{localize "sargas-encounter-builder.evaluation.selected"}}</label>{{ev.selectedLabel}}</div>
  <div class="peb-stat"><label>{{localize "sargas-encounter-builder.evaluation.target"}}</label>{{#if (ne ev.target null)}}{{ev.target}} XP{{else}}—{{/if}}</div>
  <div class="peb-stat"><label>{{localize "sargas-encounter-builder.evaluation.supported"}}</label>{{ev.supportedXP}} XP</div>
  <div class="peb-stat"><label>{{localize "sargas-encounter-builder.evaluation.difference"}}</label>{{ev.differenceLabel}}</div>
  <div class="peb-stat"><label>{{localize "sargas-encounter-builder.evaluation.completeness"}}</label>{{ev.completeLabel}}</div>
  <div class="peb-stat"><label>{{localize "sargas-encounter-builder.evaluation.inferred"}}</label>{{ev.inferredLabel}}</div>
</div>
<div class="peb-messages">
  {{#each ev.warnings}}<div class="peb-msg {{this.level}}">{{this.text}}</div>{{/each}}
</div>
