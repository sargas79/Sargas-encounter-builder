<nav class="seb-tabs" role="tablist">
  {{#each tabs}}
  <button type="button" class="seb-tab-button{{#if this.active}} is-active{{/if}}" role="tab" aria-selected="{{#if this.active}}true{{else}}false{{/if}}" data-action="selectTab" data-tab="{{this.id}}" {{#if this.disabled}}disabled data-tooltip="{{this.tooltip}}"{{/if}}>
    <i class="{{this.icon}}"></i> {{this.label}}
  </button>
  {{/each}}
</nav>
