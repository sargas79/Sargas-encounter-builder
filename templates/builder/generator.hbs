<details class="peb-generator" open>
  <summary>{{localize "pf2e-encounter-builder.generator.title"}}</summary>
  <div class="peb-filters">
    <label>{{localize "pf2e-encounter-builder.generator.relativeMin"}} <input type="number" name="gen.relativeMin" min="-4" max="4" value="{{generator.options.relativeMin}}"></label>
    <label>{{localize "pf2e-encounter-builder.generator.relativeMax"}} <input type="number" name="gen.relativeMax" min="-4" max="4" value="{{generator.options.relativeMax}}"></label>
    <label>{{localize "pf2e-encounter-builder.generator.minCount"}} <input type="number" name="gen.minCount" min="1" max="40" value="{{generator.options.minCount}}"></label>
    <label>{{localize "pf2e-encounter-builder.generator.maxCount"}} <input type="number" name="gen.maxCount" min="1" max="40" value="{{generator.options.maxCount}}"></label>
    <label>{{localize "pf2e-encounter-builder.generator.composition.label"}}
      <select name="gen.composition">{{#each generator.compositions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}</select>
    </label>
    <label>{{localize "pf2e-encounter-builder.generator.duplicateCap"}} <input type="number" name="gen.duplicateCap" min="1" max="40" value="{{generator.options.duplicateCap}}"></label>
    <label class="span2">{{localize "pf2e-encounter-builder.generator.seed"}} <input type="text" name="gen.seed" value="{{generator.options.seed}}" placeholder="{{localize "pf2e-encounter-builder.generator.seedPlaceholder"}}"></label>
  </div>
  <div class="peb-tags">{{localize "pf2e-encounter-builder.generator.filtersHint"}} {{#if generator.lockedCount}}· {{localize "pf2e-encounter-builder.generator.lockedHint" count=generator.lockedCount}}{{/if}}</div>
  {{#if generator.excluded.length}}
  <div class="peb-tags">{{localize "pf2e-encounter-builder.generator.excluded"}}:
    {{#each generator.excluded}}<span>{{this.name}} <a data-action="ext" data-ext="generator" data-method="unexclude" data-uuid="{{this.uuid}}"><i class="fa-solid fa-xmark"></i></a></span> {{/each}}
  </div>
  {{/if}}
  <div class="peb-toolbar">
    <button type="button" data-action="ext" data-ext="generator" data-method="generate" {{#unless generator.canGenerate}}disabled{{/unless}}><i class="fa-solid fa-dice"></i> {{localize "pf2e-encounter-builder.generator.generate"}}</button>
    <button type="button" data-action="ext" data-ext="generator" data-method="regenerate" {{#unless generator.canGenerate}}disabled{{/unless}}><i class="fa-solid fa-rotate-right"></i> {{localize "pf2e-encounter-builder.generator.regenerate"}}</button>
    {{#if generator.lastSeed}}<span class="peb-tags">{{localize "pf2e-encounter-builder.generator.lastSeed"}}: {{generator.lastSeed}}</span>{{/if}}
  </div>
  {{#if generator.last}}
    {{#if generator.last.ok}}
    <div class="peb-msg ok">{{generator.last.fitLabel}}: {{generator.last.totalXP}} / {{generator.last.target}} XP ({{generator.last.difference}}) · {{localize "pf2e-encounter-builder.generator.feasible" count=generator.last.feasible}}{{#if generator.last.capped}} · {{localize "pf2e-encounter-builder.generator.capped"}}{{/if}}</div>
    {{else}}
    <div class="peb-msg error">{{generator.last.reason}} <span class="peb-tags">{{generator.last.detail}}</span></div>
    {{/if}}
  {{/if}}
</details>
